{
  "name": "@dnam-project/studio",
  "version": "0.1.0",
  "description": "Unified Rust/Node dnam CLI and Tauri v2 Desktop Studio for Dynamic Neural Audio Modeler (DNAM / Tri-Physics)",
  "type": "module",
  "license": "LicenseRef-DNAM-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dnam-project/dnam.git",
    "directory": "packages/studio"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "dnam": "./bin/dnam.mjs"
  },
  "files": [
    "dist",
    "bin",
    "tauri.conf.json",
    "capabilities",
    "isolation",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    }
  },
  "dependencies": {
    "@dnam-project/engine": "workspace:*",
    "@dnam-project/ui": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tauri-apps/api": "catalog:",
    "@tauri-apps/plugin-dialog": "catalog:",
    "@tauri-apps/plugin-opener": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "@tauri-apps/cli": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  }
}
