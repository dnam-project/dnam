{
  "name": "dnam-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Dynamic Neural Audio Modeler (DNAM / Tri-Physics) JavaScript, TypeScript & WebAudio Workspace",
  "license": "LicenseRef-DNAM-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dnam-project/dnam.git"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @dnam-project/studio run test:e2e",
    "coverage": "pnpm -r run coverage",
    "bench": "pnpm -r run bench",
    "lint": "pnpm --filter @dnam-project/engine run lint",
    "format:check": "pnpm --filter @dnam-project/engine run format:check",
    "typecheck": "pnpm -r run typecheck",
    "ui:dev": "pnpm --filter @dnam-project/ui run dev",
    "studio:dev": "pnpm --filter @dnam-project/studio run dev",
    "studio:tauri": "pnpm --filter @dnam-project/studio run tauri:dev"
  }
}
