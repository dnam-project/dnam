{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DNAM Studio",
  "version": "0.1.0",
  "identifier": "org.dnam-project.studio",
  "build": {
    "frontendDist": "./dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DNAM Studio — Tri-Physics Neural Audio Modeler",
        "width": 1360,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self'; object-src 'none'; base-uri 'self'",
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": false,
        "scope": []
      },
      "pattern": {
        "use": "isolation",
        "options": {
          "dir": "./isolation"
        }
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["dnam"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAwMDAwMDAwMDAwMDAwMDAKUldR",
      "endpoints": ["https://releases.dnam-project.org/{{target}}/{{arch}}/{{current_version}}"]
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"]
  }
}
