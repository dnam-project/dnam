{
  "name": "@dnam-project/ui",
  "version": "0.1.0",
  "description": "Unified React 19, Tailwind CSS v4, shadcn/ui (Base UI), and lucide-react Design System for DNAM Desktop Studio and Web Playground",
  "type": "module",
  "license": "LicenseRef-DNAM-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dnam-project/dnam.git",
    "directory": "packages/ui"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "src/styles.css",
    "components.json",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./visualizers": {
      "types": "./dist/components/visualizers/index.d.ts",
      "default": "./dist/components/visualizers/index.js"
    }
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@dnam-project/engine": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "catalog:",
    "playwright": "catalog:",
    "react-cosmos": "catalog:",
    "react-cosmos-plugin-vite": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  }
}
