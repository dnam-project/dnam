{
  "name": "@dnam-project/ui",
  "version": "0.1.0",
  "description": "Unified React 19, Tailwind CSS v4, shadcn/ui (Base UI), and lucide-react Design System for DNAM Desktop Studio and Web Playground",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "src/styles.css",
    "components.json",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./visualizers": {
      "types": "./dist/components/visualizers/index.d.ts",
      "default": "./dist/components/visualizers/index.js"
    }
  },
  "scripts": {
    "dev": "cosmos",
    "cosmos:export": "cosmos-export",
    "build": "vite build --mode lib && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format:check": "biome format .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "bench": "vitest bench --run"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@dnam-project/engine": "workspace:*",
    "@tailwindcss/vite": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "playwright": "^1.64.1",
    "react-cosmos": "^7.4.1",
    "react-cosmos-plugin-vite": "^7.4.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  }
}
