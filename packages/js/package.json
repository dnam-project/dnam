{
  "name": "@dnam-project/engine",
  "version": "0.1.0",
  "description": "TypeScript, Node.js N-API, and WebAssembly SIMD128 / WebAudio AudioWorklet SDK for the Dynamic Neural Audio Modeler (DNAM / Tri-Physics)",
  "type": "module",
  "license": "LicenseRef-DNAM-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dnam-project/dnam.git",
    "directory": "packages/js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/node.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/node.js",
      "browser": "./dist/browser.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./worklet": {
      "types": "./dist/worklet/index.d.ts",
      "default": "./dist/worklet/index.js"
    },
    "./worklet-processor": {
      "types": "./dist/worklet/processor.d.ts",
      "default": "./dist/worklet-processor.js"
    },
    "./dnam_engine.wasm": "./dist/dnam_engine.wasm"
  },
  "scripts": {
    "build": "moon run js:build",
    "typecheck": "moon run js:typecheck",
    "lint": "moon run js:lint",
    "format:check": "moon run js:format-check",
    "test": "moon run js:test",
    "coverage": "moon run js:coverage",
    "bench": "moon run js:bench"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fast-check/vitest": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
